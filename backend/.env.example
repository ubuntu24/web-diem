# ==========================================
# LifeSuck Backend Environment Configuration
# ==========================================

# -----------------------------
# Database Configuration
# -----------------------------
# Standard PostgreSQL URL (Recommended)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifesuck_db

# Alternative individual DB credentials (used if DATABASE_URL is not set):
# user=postgres
# password=postgres
# host=localhost
# port=5432
# dbname=lifesuck_db

# -----------------------------
# Security & Secret Keys
# -----------------------------
# Mandatory 32+ character secret key for JWT & session security
SECRET_KEY=change-this-secret-key-in-production-min-32-chars-long

# Optional obfuscation keys (auto-derived from SECRET_KEY if omitted)
# OBFUSCATION_ID_KEY=your-custom-obfuscation-id-key
# PAYLOAD_OBFUSCATION_KEY=your-custom-payload-obfuscation-key

# Admin password for protected administrative endpoints
ADMIN_PASSWORD=admin_secret_123

# -----------------------------
# Server & CORS Settings
# -----------------------------
# Environment mode: 'development' or 'production'
ENV=development
NODE_ENV=development

# Host & Port settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host filtering & extra trusted hosts
ALLOWED_HOSTS=localhost,127.0.0.1
EXTRA_TRUSTED_HOSTS=localhost,127.0.0.1

# Maximum request body size in bytes (1048576 = 1MB)
MAX_REQUEST_BYTES=1048576

# -----------------------------
# Redis Cache (Optional)
# -----------------------------
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0
