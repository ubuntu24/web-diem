# ==========================================
# LifeSuck Frontend Environment Configuration
# ==========================================

# -----------------------------
# API Endpoints
# -----------------------------
# Backend API URL for Server Actions & BFF proxy (server-side)
API_URL=http://127.0.0.1:8000

# Backend API URL accessible from client browser
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws

# -----------------------------
# Security & Secret Keys
# -----------------------------
# Shared secret key matching backend's SECRET_KEY (used for BFF payload security)
SECRET_KEY=change-this-secret-key-in-production-min-32-chars-long

# Optional payload obfuscation key (matching backend if set)
# PAYLOAD_OBFUSCATION_KEY=your-custom-payload-obfuscation-key

# -----------------------------
# BFF & Server Settings
# -----------------------------
# BFF Layer cache limit
BFF_CACHE_MAX_KEYS=1000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Port for Next.js frontend app
PORT=3000

# -----------------------------
# Third-Party Integrations (Optional)
# -----------------------------
# Telegram bot notification credentials for feedback submission
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here
